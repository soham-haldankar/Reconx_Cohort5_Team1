<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV017 — Seed data (counterparties, instruments, trades, recon
 breaks, users)
 WHAT:    counterparties, instruments, trades, and recon_breaks are all now
          seeded from a single file, data/seed_data.sql, run via Liquibase's
          <sqlFile>. users are still seeded via <insert> (needs real BCrypt
          hashes, not something a plain SQL script should hardcode inline
          here either way — kept as-is).
 HOW:     <sqlFile> reads from classpath — path is relative to the
          changeSet file, same convention the old <loadData> CSVs used.
 WHY:     The student copy ships an empty DB; the trainer copy ships seeded
          data so demos work the moment the app boots. context="dev,test"
          ensures this never runs against a prod target.
 OBSERVE: SELECT count(*) FROM counterparties → 10. instruments → 50.
          trades → 500, ~125 per monthly partition. recon_breaks → up to 30.
          users → 4.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <!--
    NOTE: counterparties, instruments, trades, and recon_breaks are all now
    seeded together from data/seed_data.sql (see the single
    008-seed-data changeset below) instead of the CSV loadData / inline SQL
    changesets below. Left in place, commented out, for reference. DO NOT
    uncomment these alongside 008-seed-data — seed_data.sql already inserts
    into these same tables, so running both would double-insert / violate
    the trade_ref unique constraint.

    <changeSet id="008-seed-counterparties" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties
            </sqlCheck>
        </preConditions>
        <loadData file="data/counterparties.csv" tableName="counterparties"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>
    </changeSet>


    <changeSet id="008-seed-instruments" author="trainer" context="dev,test">
    <preConditions onFail="MARK_RAN">
        <sqlCheck expectedResult="0">
            SELECT COUNT(*) FROM instruments
        </sqlCheck>
    </preConditions>
    <sql splitStatements="false">
        INSERT INTO instruments (symbol, name, asset_class, currency, isin) VALUES
          ('SAP.DE', 'SAP SE',                'EQUITY',       'EUR', 'DE0007164600'),
          ('US10Y',  'US 10-Year Treasury',   'FIXED_INCOME', 'USD', 'US912828F622'),
          ('EURUSD', 'Euro / US Dollar',      'FX',           'USD', NULL),
          ('XAU',    'Spot Gold',             'COMMODITY',    'USD', NULL),
          ('CL_FUT', 'WTI Crude Oil Futures', 'DERIVATIVE',   'USD', NULL);

        INSERT INTO instruments (symbol, name, asset_class, currency, isin)
        SELECT
            'GEN' || LPAD(g::TEXT, 4, '0'),
            'Generated Instrument ' || g,
            (ARRAY['EQUITY','FIXED_INCOME','FX','COMMODITY','DERIVATIVE'])[1 + (g % 5)],
            (ARRAY['USD','EUR','GBP','JPY','CHF'])[1 + (g % 5)],
            NULL
        FROM generate_series(1, 45) AS g;
    </sql>
    <rollback>
        <sql>DELETE FROM instruments;</sql>
    </rollback>
    </changeSet>


    <changeSet id="008-seed-trades" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM trades
            </sqlCheck>
        </preConditions>
        <sql splitStatements="false">
            INSERT INTO trades (trade_ref, instrument_id, counterparty_id, asset_class, side, quantity, price, trade_date, status)
            SELECT
                'TRD-2026-' || LPAD(n::TEXT, 6, '0')                     AS trade_ref,
                1 + (n % 50)                                              AS instrument_id,
                1 + (n % 10)                                              AS counterparty_id,
                (ARRAY['EQUITY','FIXED_INCOME','FX','COMMODITY','DERIVATIVE'])[1 + (n % 5)] AS asset_class,
                (ARRAY['BUY','SELL'])[1 + (n % 2)]                        AS side,
                ROUND((random() * 10000 + 1)::NUMERIC, 4)                 AS quantity,
                ROUND((random() * 500 + 1)::NUMERIC, 4)                   AS price,
                DATE '2026-04-01' + (n % 120) * INTERVAL '1 day'          AS trade_date,
                (ARRAY['PENDING','MATCHED','UNMATCHED','DISPUTED','MATCHED','MATCHED'])[1 + (n % 6)] AS status
            FROM generate_series(1, 500) AS n;
        </sql>
        <rollback>
            <sql>DELETE FROM trades;</sql>
        </rollback>
    </changeSet>


    <changeSet id="008-seed-recon-breaks" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM recon_breaks
            </sqlCheck>
        </preConditions>
        <sql splitStatements="false">
            INSERT INTO recon_breaks (trade_id, discrepancy_type, status)
            SELECT id,
                   (ARRAY['PRICE_MISMATCH','QUANTITY_MISMATCH','DATE_MISMATCH'])[1 + (id % 3)],
                   'OPEN'
            FROM trades
            WHERE status IN ('UNMATCHED','DISPUTED')
            LIMIT 30;
        </sql>
        <rollback>
            <sql>DELETE FROM recon_breaks;</sql>
        </rollback>
    </changeSet>
    -->


    <!-- ADV017: counterparties, instruments, trades, and recon_breaks all
         loaded from a single SQL source file (data/seed_data.sql) instead
         of the CSV loadData / inline SQL above. Keeps the whole seed —
         10 counterparties, 50 instruments (5 explicit + 45 generated),
         500 trades spread across four monthly partitions, and ~30 recon
         breaks — in one deterministic file that can also be run standalone
         via psql for local debugging. -->
    <changeSet id="008-seed-data" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties
            </sqlCheck>
        </preConditions>
        <sqlFile path="data/seed_data.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
        <rollback>
            <sql>DELETE FROM recon_breaks;</sql>
            <sql>DELETE FROM trades;</sql>
            <sql>DELETE FROM instruments;</sql>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>
    </changeSet>


    <changeSet id="008-seed-users" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM users WHERE email IN
                ('admin@db.com','trader@db.com','viewer@db.com','recon@db.com')
            </sqlCheck>
        </preConditions>
        <!-- Real BCrypt hashes (cost=10) for admin123 / trader123 / viewer123 / recon123.
             Generated via: htpasswd -bnBC 10 "" <pw> | tr -d ':\n'
             Spring Security's BCryptPasswordEncoder accepts both $2a$ and $2y$ prefixes. -->
        <insert tableName="users">
            <column name="email" value="admin@db.com"/>
            <column name="password_hash" value="$2y$10$L9iP3BfsBS2LbVJRfc86TuWnJvP.AohjX3PNLwdtjlZfyB7YSp87C"/>
            <column name="role" value="ADMIN"/>
        </insert>
        <insert tableName="users">
            <column name="email" value="trader@db.com"/>
            <column name="password_hash" value="$2y$10$LIpkayi0QDWyVguPtEQbkOATM7PTnMKFDNq47K92TUx2LHTBFQf1i"/>
            <column name="role" value="TRADER"/>
        </insert>
        <insert tableName="users">
            <column name="email" value="viewer@db.com"/>
            <column name="password_hash" value="$2y$10$gC8J5Tzr15p4V6BgbbEFGOEb4VWM4YUOAdKEeyFlXtEvYolYblCVC"/>
            <column name="role" value="VIEWER"/>
        </insert>
        <insert tableName="users">
            <column name="email" value="recon@db.com"/>
            <column name="password_hash" value="$2y$10$UVYhlvPX38zSdPhY6bz4ee453bh6gXp9guhAfV5IU2SjcWPm0eWKq"/>
            <column name="role" value="RECON_ANALYST"/>
        </insert>
        <rollback>
            <sql>DELETE FROM users;</sql>
        </rollback>
    </changeSet>


</databaseChangeLog>